# Portaldot V3 EVM connection. Never commit a real private key.
PORTALDOTV3_TESTNET_RPC_URL=https://test-evm-rpc-v3.portaldot.dev
PRIVATE_KEY=0x

# Shared Factory deployment (after the Factory has been deployed and verified).
# All FairDot-compatible platforms must use the same Factory/Registry address to interoperate.
FAIRDOT_FACTORY_ADDRESS=

# Meme launch configuration used by scripts/createMeme.cjs.
# Choose the seed first, then finalize both volume inputs before launch.
MEME_NAME=
MEME_SYMBOL=
INITIAL_SUPPLY_TOKENS=1000000000
SEED_TOKEN_AMOUNT_TOKENS=
INITIAL_LIQUIDITY_TPOT=
MIN_VOLUME_BPS=
MIN_VOLUME_ABSOLUTE_TPOT=
