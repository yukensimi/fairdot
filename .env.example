# Private key belonging to the PortaldotV3 EVM H160 account; fund its mapped SS58 address for gas.
# Keep this key only in .env, never commit it.
PORTALDOTV3_TESTNET_RPC_URL=https://test-evm-rpc-v3.portaldot.dev
PRIVATE_KEY=0x

# Optional: set both values only when you intend the deployment script to seed the pool.
# These are human-readable amounts, not recommended liquidity values.
# INITIAL_LIQUIDITY_TOKEN_AMOUNT=1000000
# INITIAL_LIQUIDITY_TPOT=100

# Set after deployment (optional reference)
FAIRDOT_ADDRESS=
